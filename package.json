{
  "name": "sp-sweet-spot",
  "productName": "sp",
  "version": "0.1.0",
  "description": "sp — sweet spot. Личный центр учёбы: планировщик, расписание, музыка, анки.",
  "author": "exeen-pip",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "test": "node test/run.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "kz.sweetspot.app",
    "productName": "sp",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lan.js",
      "src/**/*",
      "mobile/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
